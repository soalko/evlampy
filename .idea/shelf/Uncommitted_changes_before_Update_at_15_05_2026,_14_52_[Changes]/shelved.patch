+void ChatServer::persistUsersToDiskUnlocked() const {
+	const auto path = userStorePath();
+	std::error_code ec;
+	std::filesystem::create_directories(path.parent_path(), ec);
+	if (ec) {
+		return;
+	}
+
+	std::ofstream out(path, std::ios::binary | std::ios::trunc);
+	if (!out) {
+		return;
+	}
+
+	const char magic[4] = {'E', 'V', 'U', '1'};
+	out.write(magic, sizeof(magic));
+	const std::uint32_t count = static_cast<std::uint32_t>(users_.size());
+	out.write(reinterpret_cast<const char*>(&count), sizeof(count));
+
+	for (const auto& [username, user] : users_) {
+		writeString(out, username);
+		writeString(out, user.passwordHash);
+		writeString(out, user.publicKeyPem);
+		writeString(out, user.email);
+
+		const std::uint8_t blocked = user.blocked ? 1 : 0;
+		const std::uint8_t isAdmin = user.isAdmin ? 1 : 0;
+		out.write(reinterpret_cast<const char*>(&blocked), sizeof(blocked));
+		out.write(reinterpret_cast<const char*>(&isAdmin), sizeof(isAdmin));
+
+		const std::uint32_t contactsCount = static_cast<std::uint32_t>(user.contacts.size());
+		out.write(reinterpret_cast<const char*>(&contactsCount), sizeof(contactsCount));
+		for (const auto& contact : user.contacts) {
+			writeString(out, contact);
+		}
+	}
+}
+
+void ChatServer::loadUsersFromDisk() {
+	const auto path = userStorePath();
+	std::ifstream in(path, std::ios::binary);
+	if (!in) {
+		return;
+	}
+
+	char magic[4] = {};
+	in.read(magic, sizeof(magic));
+	if (!in || magic[0] != 'E' || magic[1] != 'V' || magic[2] != 'U' || magic[3] != '1') {
+		return;
+	}
+
+	std::uint32_t count = 0;
+	in.read(reinterpret_cast<char*>(&count), sizeof(count));
+	if (!in) {
+		return;
+	}
+
+	for (std::uint32_t i = 0; i < count; ++i) {
+		std::string username;
+		UserRecord user;
+		if (!readString(in, username) ||
+			!readString(in, user.passwordHash) ||
+			!readString(in, user.publicKeyPem) ||
+			!readString(in, user.email)) {
+			users_.clear();
+			return;
+		}
+
+		std::uint8_t blocked = 0;
+		std::uint8_t isAdmin = 0;
+		in.read(reinterpret_cast<char*>(&blocked), sizeof(blocked));
+		in.read(reinterpret_cast<char*>(&isAdmin), sizeof(isAdmin));
+		if (!in) {
+			users_.clear();
+			return;
+		}
+		user.blocked = blocked != 0;
+		user.isAdmin = isAdmin != 0;
+
+		std::uint32_t contactsCount = 0;
+		in.read(reinterpret_cast<char*>(&contactsCount), sizeof(contactsCount));
+		if (!in) {
+			users_.clear();
+			return;
+		}
+		for (std::uint32_t c = 0; c < contactsCount; ++c) {
+			std::string contact;
+			if (!readString(in, contact)) {
+				users_.clear();
+				return;
+			}
+			user.contacts.insert(std::move(contact));
+		}
+
+		users_.emplace(std::move(username), std::move(user));
+	}
+}
