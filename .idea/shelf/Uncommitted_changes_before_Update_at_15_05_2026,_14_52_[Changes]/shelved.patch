+std::optional<std::string> ChatServer::createGroup(const std::string& owner,
+													const std::string& groupName,
+													const std::vector<std::string>& members) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (users_.find(owner) == users_.end() || groupName.empty()) {
+		return std::nullopt;
+	}
+	const auto groupId = makeGroupId(owner, groupName);
+	if (groups_.find(groupId) != groups_.end()) {
+		return std::nullopt;
+	}
+
+	GroupRecord group;
+	group.groupId = groupId;
+	group.owner = owner;
+	group.name = groupName;
+	group.members.insert(owner);
+	for (const auto& member : members) {
+		if (users_.find(member) != users_.end()) {
+			group.members.insert(member);
+		}
+	}
+	groups_.emplace(groupId, std::move(group));
+	persistUsersToDiskUnlocked();
+	appendAudit(owner, "create_group", groupId);
+	return groupId;
+}
