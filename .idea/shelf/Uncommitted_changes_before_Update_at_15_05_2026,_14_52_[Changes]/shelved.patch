+bool ChatServer::markDelivered(const std::string& messageId, const std::string& receiver) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	const auto idxIt = messageIndex_.find(messageId);
+	if (idxIt == messageIndex_.end()) {
+		return false;
+	}
+
+	auto& bucket = idxIt->second.isGroup ? groupHistory_[idxIt->second.key] : history_[idxIt->second.key];
+	if (idxIt->second.index >= bucket.size()) {
+		return false;
+	}
+	auto& message = bucket[idxIt->second.index];
+	if (message.receiver != receiver || message.deletedForAll) {
+		return false;
+	}
+	if (message.status == MessageStatus::Sent) {
+		message.status = MessageStatus::Delivered;
+	}
+	return true;
+}
+
+bool ChatServer::markRead(const std::string& messageId, const std::string& reader) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	const auto idxIt = messageIndex_.find(messageId);
+	if (idxIt == messageIndex_.end()) {
+		return false;
+	}
+
+	auto& bucket = idxIt->second.isGroup ? groupHistory_[idxIt->second.key] : history_[idxIt->second.key];
+	if (idxIt->second.index >= bucket.size()) {
+		return false;
+	}
+	auto& message = bucket[idxIt->second.index];
+	if (message.receiver != reader || message.deletedForAll) {
+		return false;
+	}
+	message.status = MessageStatus::Read;
+	appendAudit(reader, "mark_read", messageId);
+	return true;
+}
+
+bool ChatServer::deleteMessageForAll(const std::string& requester, const std::string& messageId) {
+	std::lock_guard<std::mutex> lock(mutex_);
+	const auto idxIt = messageIndex_.find(messageId);
+	if (idxIt == messageIndex_.end()) {
+		return false;
+	}
+
+	auto& bucket = idxIt->second.isGroup ? groupHistory_[idxIt->second.key] : history_[idxIt->second.key];
+	if (idxIt->second.index >= bucket.size()) {
+		return false;
+	}
+	auto& message = bucket[idxIt->second.index];
+	if (message.sender != requester) {
+		return false;
+	}
+	message.deletedForAll = true;
+	message.encryptedPayload.clear();
+	message.encryptedSessionKey.clear();
+	message.senderEncryptedSessionKey.clear();
+	appendAudit(requester, "delete_message", messageId);
+	return true;
+}
