+bool ChatClient::saveKeyPairToDisk() const {
+	if (keyPair_.publicKeyPem.empty() || keyPair_.privateKeyPem.empty()) {
+		return false;
+	}
+
+	const auto dir = keyStoreDir();
+	std::error_code ec;
+	std::filesystem::create_directories(dir, ec);
+	if (ec) {
+		return false;
+	}
+
+	const auto safeUser = sanitizeForFileName(username_);
+	const auto pubPath = dir / (safeUser + ".pub.pem");
+	const auto privPath = dir / (safeUser + ".priv.pem");
+
+	{
+		std::ofstream out(pubPath, std::ios::binary | std::ios::trunc);
+		if (!out) {
+			return false;
+		}
+		out << keyPair_.publicKeyPem;
+	}
+
+	{
+		std::ofstream out(privPath, std::ios::binary | std::ios::trunc);
+		if (!out) {
+			return false;
+		}
+		out << keyPair_.privateKeyPem;
+	}
+
+	return true;
+}
+
+bool ChatClient::loadKeyPairFromDisk() {
+	const auto safeUser = sanitizeForFileName(username_);
+	const auto dir = keyStoreDir();
+	const auto pubPath = dir / (safeUser + ".pub.pem");
+	const auto privPath = dir / (safeUser + ".priv.pem");
+
+	std::ifstream pub(pubPath, std::ios::binary);
+	std::ifstream priv(privPath, std::ios::binary);
+	if (!pub || !priv) {
+		return false;
+	}
+
+	const std::string publicPem((std::istreambuf_iterator<char>(pub)), std::istreambuf_iterator<char>());
+	const std::string privatePem((std::istreambuf_iterator<char>(priv)), std::istreambuf_iterator<char>());
+
+	if (publicPem.empty() || privatePem.empty()) {
+		return false;
+	}
+
+	keyPair_.publicKeyPem = publicPem;
+	keyPair_.privateKeyPem = privatePem;
+	return true;
+}
